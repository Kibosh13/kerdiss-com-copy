Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:data|server|node_modules|\.git|\.env|dist/content|dist/templates)(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
<FilesMatch "(^\.|\.(sqlite|db|env|sql|bak|log)$)">
Require all denied
</FilesMatch>
